# ==============================================================================
# SprintFlow — copy to .env and fill in. `.env` is gitignored; never commit it.
#
# This one file feeds BOTH docker-compose variable substitution (${VAR} in
# docker-compose.yml) AND the ai-core container's environment (via env_file).
# ==============================================================================

# --- Environment ---------------------------------------------------------
APP_ENV=development
TZ=UTC

# --- Host ports ----------------------------------------------------------
MATTERMOST_HOST_PORT=8065
# ai-core is intentionally NOT published to the host — it is reached by
# service name on the internal network. Nothing here to set.

# --- Postgres ------------------------------------------------------------
# One cluster, two databases. POSTGRES_DB is ai-core's; MATTERMOST_DB is
# created by postgres/init/01-create-databases.sh on first boot.
# Keep the password alphanumeric: it is embedded in Mattermost's DSN, where
# special characters would need URL-encoding.
POSTGRES_DB=sprintflow
POSTGRES_USER=sprintflow
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_password
MATTERMOST_DB=mattermost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# --- Mattermost ----------------------------------------------------------
# Must match the URL you open in the browser.
MM_SITE_URL=http://localhost:8065

# Filled in by scripts/bootstrap_mattermost.sh — leave blank on first boot.
MATTERMOST_BOT_TOKEN=
MATTERMOST_OUTGOING_WEBHOOK_TOKEN=
MATTERMOST_BOT_USERNAME=sprintflow-assistant
MATTERMOST_HTTP_TIMEOUT=30

# WebSocket listener — the ONLY way to receive direct messages, because
# Mattermost never fires outgoing webhooks outside public channels.
MATTERMOST_WS_ENABLED=true
# D = direct, G = group message, P = private channel, O = public channel.
# "O" is required for thread continuity: a follow-up inside a thread carries no
# trigger word, so the outgoing webhook never fires for it. Double replies are
# prevented by routing, not by this list — the listener skips any public post
# whose FIRST WORD is a trigger word, because the webhook already owns it.
MATTERMOST_WS_CHANNEL_TYPES=D,O

# Trigger words on the Mattermost outgoing webhook. Single source of truth:
# scripts/bootstrap_mattermost.sh creates the webhook from this list, and
# ai-core reads it to know which messages the webhook already owns. Change it
# in one place and re-run the bootstrap.
MATTERMOST_TRIGGER_WORDS="@sprintflow-assistant,!ask"

# How long to remember that the bot is part of a thread (seconds). Only
# positive results are cached; participation never becomes false.
MATTERMOST_THREAD_CACHE_TTL=900

# Admin account the bootstrap script creates.
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=CHANGE_ME_Admin123!
MM_ADMIN_EMAIL=admin@sprints.ai
MM_TEAM_NAME=sprints-community
MM_TEAM_DISPLAY_NAME="Sprints Community"
MM_BOT_CHANNEL=town-square

# --- White-labelling (SprintFlow) ----------------------------------------
# All supported on Team Edition without a licence. Themes are NOT — they are
# licence-gated, so everyone sees the stock Denim theme.
MM_SITE_NAME=SprintFlow
MM_CUSTOM_BRAND_TEXT="Your virtual workspace."
MM_CUSTOM_DESCRIPTION_TEXT="SprintFlow — build, ship and learn together."

# --- Default team and onboarding -----------------------------------------
# Channels every user joins with ANY team — ExperimentalDefaultChannels is
# server-wide, not per-team, so this is the baseline for every team ever
# created here. Mattermost's env decoder splits slice values on SPACES, so
# this must NOT be comma-separated.
MM_DEFAULT_CHANNELS="announcements engineering helpdesk watercooler"

# ai-core adds each newly registered account to this team, because Mattermost
# has no configuration that joins a team automatically.
MATTERMOST_AUTO_ONBOARD=true
MATTERMOST_DEFAULT_TEAM=sprints-community

# --- Admin agent authorisation -------------------------------------------
# Explicit allowlist, comma-separated. Privileged tool calls originate from
# chat text, so this gate is deliberately held outside Mattermost and outside
# anything the model can influence. Empty = no one may use admin tools.
# An allowlisted address only counts when Mattermost marks it verified or the
# account holds the system_admin role (the bootstrap admin satisfies both);
# otherwise the sync logs identity_allowlisted_email_not_trusted.
ADMIN_EMAILS="admin@sprints.ai"

# --- LLM (LiteLLM proxy ONLY) -------------------------------------------
# Every model call in this stack goes through the LiteLLM proxy. There are no
# direct provider SDKs and no provider keys. The variables keep their OpenAI
# names because the OpenAI-compatible client and mem0 read them unmodified —
# the VALUES are LiteLLM's.
OPENAI_BASE_URL=https://management.sprints.ai/litellm/v1
OPENAI_API_KEY=CHANGE_ME_litellm_virtual_key

# LiteLLM model-group names, not OpenAI model ids.
DEFAULT_LLM_MODEL=gemini/gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini/gemini-3.1-flash-lite
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
# Separate budget for how much prior conversation is replayed to the model.
# Kept apart from MAX_TOKENS so raising context does not raise reply length.
MAX_HISTORY_TOKENS=6000
LLM_TOTAL_TIMEOUT=90
SESSION_NAMING_ENABLED=false

# Long-term memory (mem0 over Qdrant), scoped per person.
LONG_TERM_MEMORY_MODEL=gemini/gemini-3.5-flash
LONG_TERM_MEMORY_EMBEDDER_MODEL=gemini/gemini-embedding-001

# --- Vector store (external Qdrant) --------------------------------------
# mem0 long-term memory lives in Qdrant, deliberately OUTSIDE docker-compose so
# a vector-side fault can never reach Mattermost's database.
# REQUIRED: without QDRANT_URL, mem0 would silently fall back to a throwaway
# local store at /tmp/qdrant, so ai-core refuses to run memory without it.
QDRANT_URL="https://<cluster-id>.<region>.aws.cloud.qdrant.io"
QDRANT_API_KEY="CHANGE_ME_qdrant_api_key"
QDRANT_EMBEDDING_DIMS=1536
# Namespace the collection: a hosted Qdrant is often shared between projects.
LONG_TERM_MEMORY_COLLECTION_NAME=sprintflow_longterm_memory

# --- ai-core app ---------------------------------------------------------
PROJECT_NAME="SprintFlow Assistant"
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=true
ALLOWED_ORIGINS="http://localhost:8065"

# Must be 32+ characters and not a placeholder — ai-core refuses to start
# otherwise. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# --- Observability (off by default) --------------------------------------
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Sprint 1 / data model & identity ------------------------------------
# The container applies Alembic migrations before serving. Set to false for
# a one-off shell that must not touch the schema.
AI_CORE_MIGRATE_ON_START=true
# Mattermost profile reads are cached this long (seconds) by the identity sync.
IDENTITY_PROFILE_CACHE_TTL=600
# Sprint length used when a sprint is opened without an end date.
SPRINT_DEFAULT_LENGTH_DAYS=14

# --- Sprint 1 / supervisor orchestration ---------------------------------
# A message that spans several areas is decomposed into at most this many routes.
ROUTING_MAX_ROUTES_PER_TURN=2

# --- Sprint 1 / ceremony scheduling --------------------------------------
# Zone used to interpret spoken times when the requester's Mattermost profile
# declares none. Leave empty to ask the person instead of guessing.
SCHEDULING_DEFAULT_TIMEZONE=
SCHEDULING_MIN_LEAD_MINUTES=5
SCHEDULING_MAX_HORIZON_DAYS=365
# refuse (default) or warn when a new ceremony overlaps one for the same cohort.
SCHEDULING_CONFLICT_POLICY=refuse

# --- Sprint 1 / proactive onboarding -------------------------------------
ONBOARDING_ENABLED=true
ONBOARDING_FOLLOW_UP_DELAY_HOURS=72
ONBOARDING_POLL_INTERVAL_SECONDS=30
ONBOARDING_MAX_ATTEMPTS=5
ONBOARDING_RETRY_BACKOFF_SECONDS=60
ONBOARDING_CLAIM_LEASE_SECONDS=600

# Shared secret between ai-core and the Mattermost rich-artifacts plugin.
# The plugin presents it on every artifact read; ai-core refuses reads when unset.
RICH_MEDIA_PLUGIN_TOKEN=generate-with-python-secrets-token_urlsafe-32

# Image generation (Nano Banana through the LiteLLM proxy). The model is
# reached on /chat/completions, not /images/generations: the predict-style
# endpoint answers 404 for it.
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=gemini/nano-banana-pro-preview

# Files and images people attach to a message. The pipeline's thresholds
# (pages per read, render size, inline text, image edge, sheet rows…) live in
# code with documented defaults — ai-core/app/services/documents/policy.py —
# so only what a deployment genuinely decides is configured here.
FILE_INPUT_ENABLED=true
FILE_INPUT_MAX_FILE_BYTES=20971520
FILE_INPUT_RETENTION_DAYS=30
# Used for a turn carrying images when the current model cannot see; it must
# be in DEFAULT_LLM_MODEL/LLM_FALLBACK_MODELS to apply.
FILE_INPUT_VISION_MODEL=gemini/gemini-3.5-flash

# PDFs are read page by page on demand. Two decisions are the deployment's:
# which model transcribes rendered pages, and how many pages one turn may
# render and transcribe (a cost ceiling; native text and cached pages are free).
PDF_OCR_MODEL=gemini/gemini-3.1-flash-lite
PDF_PAGE_BUDGET_PER_TURN=60

# Longest message text read per turn. Above Mattermost's own post limit, so
# nothing typed is ever cut; anything longer is reported, not dropped.
MESSAGE_MAX_INPUT_CHARS=16384

# Execution tracking: each turn is a durable row, so "cancel" can stop it
# and "retry" can run it again after a failure or a restart.
EXECUTION_TRACKING_ENABLED=true
