# Secrets — never commit. Use .env.example as the template.
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
secrets/

# Mattermost runtime state (bind mounts, owned by uid 2000 inside the container)
mattermost/volumes/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
htmlcov/

# ai-core runtime output
ai-core/logs/
ai-core/evals/reports/
*.jsonl

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Internal sprint planning — deliberately NOT published to GitHub.
tasks/

# Agent worktrees created during development sessions
.claude/worktrees/

# Webapp plugin dependencies (lockfile and sources stay tracked)
node_modules/
plugins/*/dist/
plugins/*/webapp/dist/
plugins/*/server/dist/
# React UMD builds are copied from node_modules at build time (pinned in
# package.json) and embedded into the Go binary; they are build inputs, not source.
plugins/*/server/assets/react.js
plugins/*/server/assets/react-dom.js
plugins/*/server/assets/babel.js
plugins/*/server/assets/chunks/

# Generated browser evidence (screenshots, recordings, DOM/CSS diagnostics).
# Harness scripts under scripts/rtl_lab/ stay tracked; their output does not.
reports/rich-media/
reports/**/*.webm
reports/**/diag-*.json
